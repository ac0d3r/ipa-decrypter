# Add --keyring-backend flag to avoid macOS Keychain
#
# Compatible with ipatool v2.7.0.
#
# Changes:
#   - cmd/keyring_backend.go  (new)  backend selection: auto / file / keychain
#   - cmd/common.go                  wire keyringBackends() into keychain init
#   - cmd/root.go                    add --keyring-backend persistent flag
#
# Apply:
#   git apply --check patches/keyring-backend-flag.patch
#   git apply patches/keyring-backend-flag.patch
#
# Usage:
#   ipatool auth login --keyring-backend file --keychain-passphrase "your-passphrase"

