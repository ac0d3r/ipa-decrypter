diff --git a/cmd/keyring_backend.go b/cmd/keyring_backend.go
new file mode 100644
index 0000000..4127fb7
--- /dev/null
+++ b/cmd/keyring_backend.go
@@ -0,0 +1,29 @@
+package cmd
+
+import (
+	"github.com/byteness/keyring"
+	"github.com/thediveo/enumflag/v2"
+)
+
+type KeyringBackend enumflag.Flag
+
+const (
+	KeyringBackendAuto KeyringBackend = iota
+	KeyringBackendFile
+	KeyringBackendKeychain
+)
+
+func keyringBackends(backend KeyringBackend) []keyring.BackendType {
+	switch backend {
+	case KeyringBackendFile:
+		return []keyring.BackendType{keyring.FileBackend}
+	case KeyringBackendKeychain:
+		return []keyring.BackendType{keyring.KeychainBackend}
+	default:
+		return []keyring.BackendType{
+			keyring.KeychainBackend,
+			keyring.SecretServiceBackend,
+			keyring.FileBackend,
+		}
+	}
+}
