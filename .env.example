# Host port mapped to the container (default: 8080)
HOST_PORT=8080

# Host path mounted to container /data (default: ./data)
DATA_DIR=./data

# Passphrase for ipatool file keyring (change in production)
KEYCHAIN_PASSPHRASE=ipatool-ipa-decrypter

# Bootstrap admin user (created only when no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
